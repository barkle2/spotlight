validation/artifacts/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# Editor and IDE settings
.vscode/
.idea/
*.code-workspace

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
~$*
